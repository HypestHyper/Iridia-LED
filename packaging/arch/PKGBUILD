# Maintainer: HypestHyper
pkgname=iridia
pkgver=1.3.10
pkgrel=1
pkgdesc="Set RGB lights from the colours of your wallpaper, through OpenRGB"
arch=('any')
url="https://github.com/HypestHyper/Iridia-LED"
license=('MIT')
depends=('python' 'python-gobject' 'python-cairo' 'gtk4' 'python-pillow' 'python-watchdog')
optdepends=('openrgb: drives the lights (or OpenRGB from Flatpak or an AppImage)'
            'ddcutil: follow the monitor brightness'
            'python-openrgb: OpenRGB older than 1.0')
install=iridia.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/HypestHyper/Iridia-LED/releases/download/v$pkgver/iridia-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  # the same layout as the .deb and .rpm: /usr/lib/iridia, launchers in /usr/bin, the systemd user unit
  sh iridia/packaging/stage.sh "$pkgdir"
  rm -r "$pkgdir/usr/share/doc"       # Arch keeps the licence in /usr/share/licenses only
}
