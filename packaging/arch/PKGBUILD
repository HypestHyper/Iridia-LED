# Maintainer: HypestHyper
pkgname=iridia
pkgver=1.3.6
pkgrel=1
pkgdesc="Set RGB lights from the colours of your wallpaper, through OpenRGB"
arch=('any')
url="https://github.com/HypestHyper/Iridia-LED"
license=('MIT')
depends=('python' 'python-gobject' 'python-cairo' 'gtk4' 'python-pillow' 'python-watchdog' 'openrgb')
optdepends=('ddcutil: follow the monitor brightness'
            'python-openrgb: older OpenRGB versions (before 1.0)')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz::https://github.com/HypestHyper/Iridia-LED/releases/download/v$pkgver/iridia-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd iridia
  python -m build --wheel --no-isolation
}

package() {
  cd iridia
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 data/io.github.HypestHyper.Iridia.desktop "$pkgdir/usr/share/applications/io.github.HypestHyper.Iridia.desktop"
  install -Dm644 data/io.github.HypestHyper.Iridia.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.HypestHyper.Iridia.metainfo.xml"
  install -Dm644 data/icons/hicolor/scalable/apps/iridia.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/iridia.svg"
  install -Dm644 data/icons/hicolor/symbolic/apps/iridia-symbolic.svg "$pkgdir/usr/share/icons/hicolor/symbolic/apps/iridia-symbolic.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
