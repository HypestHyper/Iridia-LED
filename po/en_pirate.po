msgstr "#{h} walked the plank out o' yer chest."

msgid "The daemon isn't running."
msgstr "The bosun ain't aboard."

msgid "Your devices show up here once it runs. Start it here or from the Service tab."
msgstr "Yer cargo shows up here once he's aboard. Rouse him here or from Below Decks."

msgid "Start daemon"
msgstr "Rouse the bosun"

msgid "No devices configured."
msgstr "No cargo in the hold."

msgid ""
"Devices appear here once OpenRGB reports them. Start OpenRGB's SDK server (SDK Server tab, Start "
"Server) and make sure it lists your devices."
msgstr ""
"Cargo shows up here once OpenRGB reports it. Start OpenRGB's SDK server (SDK Server tab, Start "
"Server) and make sure it lists yer devices."

msgid "All devices"
msgstr "The whole fleet"

#, python-brace-format
msgid "Changes here apply to {n} zone."
msgid_plural "Changes here apply to all {n} zones at once."
msgstr[0] "Changes here hit {n} zone."
msgstr[1] "Changes here hit all {n} zones at once, broadside!"

msgid "Everything"
msgstr "The Whole Fleet"

msgid "Disabled"
msgstr "Marooned"

msgid "Whole device"
msgstr "The whole vessel"

msgid "Animations"
msgstr "Dancin' lanterns"

msgid "Animated effects are picked per zone on the Devices tab."
msgstr "Pick the dancin' for each zone in the Cargo hold."

msgid "Run animations"
msgstr "Let the lanterns dance"

msgid "Off: animated zones show their first color, still."
msgstr "Off: dancin' zones hold their first colour, dead calm."

msgid "Frame rate"
msgstr "Frames o' the reel"

msgid "frames per second"
msgstr "frames a second"

msgid "30 looks smooth on most strips. A device that can't keep up gets a lower rate by itself."
msgstr "30 sails smooth on most lanterns. A slow ship gets a slower beat by itself."

msgid "Pause animations during night mode"
msgstr "Still the lanterns when night falls"

msgid "Slow animations during night mode"
msgstr "Slow the lanterns when night falls"

