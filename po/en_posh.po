msgid "Identify lights only this zone, so you can see which strip it is."
msgstr "Identify illuminates this zone alone, so you may see which strip it is."

msgid "Edit layout"
msgstr "Amend the arrangement"

msgid "Reverse"
msgstr "Reverse"

msgid "Mirror"
msgstr "Mirror"

msgid ""
"Some LEDs of this strip flash for notifications (the line under them). Opens the Notifications "
"tab."
msgstr ""
"Some lamps of this strip flash for correspondence (the line beneath them). Opens the "
"Correspondence tab."

msgid "Follow monitor brightness"
msgstr "Defer to the looking-glass's brightness"

msgid "Manual"
msgstr "By hand"

msgid "No monitor brightness to follow (see Settings, Monitor brightness), so Manual is used."
msgstr ""
"No looking-glass brightness to defer to (see Settings, The looking-glass's brightness), so By "
"hand is used."

msgid "Range"
msgstr "Range"

msgid "Invert (bias lighting)"
msgstr "Invert (for bias lighting)"

msgid "Gamma correction"
msgstr "Gamma correction"

msgid "Stay lit when the screen locks or you're away"
msgstr "Remain lit when the screen locks or one steps away"

msgid "Strip type and wiring"
msgstr "Strip type and wiring"

msgid "Strip type"
msgstr "Strip type"

msgid "Color order"
msgstr "Colour order"

msgid "Test colors"
msgstr "Test the colours"

msgid ""
"Test colors lights this strip red at the LED 1 end, green in the middle and blue at the far end "
"(a one-color strip cycles red, green, blue). If the colors are wrong, change the order until they"
" match."
msgstr ""
"Test the colours lights this strip red at the lamp 1 end, green in the middle and blue at the far"
" end (a one-colour strip cycles red, green, blue). Should the colours be amiss, change the order "
"until they agree."

msgid "LEDs per pixel"
msgstr "Lamps per pixel"

msgid "Power limit"
msgstr "Limit of power"

msgid "A  (0 = no limit)"
msgstr "A  (0 = no limit)"

msgid ""
"Long 5V strips at full white pull a lot of current: the far end turns orange or pink, or the "
"controller resets. Set your power supply's amps (minus a bit) and Iridia dims only when a color "
"would go over it. The estimate assumes 60 mA per LED at full white."
msgstr ""
"Long 5V strips at full white draw a great deal of current: the far end turns orange or pink, or "
"the controller swoons. Set your power supply's amperes (less a little) and Iridia dims only when "
"a colour would exceed them. The estimate presumes 60 mA per lamp at full white."

msgid "Resize the OpenRGB zone"
msgstr "Resize the OpenRGB zone"

msgid "Stop test"
msgstr "Conclude the test"

#, python-brace-format
msgid "Asked OpenRGB for {need} LEDs on this zone"
msgstr "OpenRGB was asked for {need} lamps upon this zone"

#, python-brace-format
msgid "Notifications: LEDs {leds}"
msgstr "Correspondence: lamps {leds}"

msgid "(off)"
msgstr "(off)"

#, python-brace-format
msgid "(looks like: {type})"
msgstr "(it appears to be: {type})"

#, python-brace-format
msgid "Strip: {type}"
msgstr "Strip: {type}"

#, python-brace-format
msgid "Right now about {now:.1f} A, {full:.1f} A at full white."
msgstr "At present some {now:.1f} A, {full:.1f} A at full white."

#, python-brace-format
msgid "Dimmed to stay under the limit (would be {amps:.1f} A)."
msgstr "Dimmed to remain within the limit (it would have been {amps:.1f} A)."

#, python-brace-format
msgid "For {n} RGBW LEDs the OpenRGB zone needs {need} LEDs; right now the end of the strip stays dark."
msgstr "For {n} RGBW lamps the OpenRGB zone requires {need}; at present the end of the strip remains dark."

