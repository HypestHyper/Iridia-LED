msgid "It shows on the Devices and Layout tabs. Leave it empty to use the original name."
msgstr ""
"The name shall appear upon the Apparatus and Floor Plan pages. Leave it blank to restore its "
"given name."

msgid "Keep it under 40 characters."
msgstr "Kindly keep it under forty characters."

msgid "Iridia"
msgstr "Iridia"

