#!/usr/bin/env python3
"""A stand-in for OpenRGB in tests: put this folder first on PATH.

FAKE_OPENRGB_MODE (default "zero"):
  zero    with --server: an SDK server that answers the handshake and reports no devices
  alive   stays running without listening (an OpenRGB window with its SDK server off)
  crash   exits right away with code 3
FAKE_OPENRGB_LOG: a file each start is appended to ("PID ARG ARG...").
"""
import os
import signal
import socket
import struct
import sys
import threading
import time

# Look like the real binary to process scans (/proc/PID/comm), not like "python3".
try:
    with open("/proc/self/comm", "w") as f:
        f.write("openrgb")
except OSError:
    pass
mode = os.environ.get("FAKE_OPENRGB_MODE", "zero")
log = os.environ.get("FAKE_OPENRGB_LOG")
if log:
    with open(log, "a") as f:
        f.write(f"{os.getpid()} {' '.join(sys.argv[1:])}\n")
print(f"fake openrgb {os.getpid()} mode={mode} args={sys.argv[1:]}", flush=True)
signal.signal(signal.SIGTERM, lambda *a: os._exit(0))
if mode == "crash":
    sys.exit(3)
if mode == "alive" or "--server" not in sys.argv:
    while True:
        time.sleep(1)

port = 6742
if "--server-port" in sys.argv:
    port = int(sys.argv[sys.argv.index("--server-port") + 1])


def recv_exact(conn, n):
    data = b""
    while len(data) < n:
        chunk = conn.recv(n - len(data))
        if not chunk:
            raise ConnectionError
        data += chunk
    return data


def reply(conn, ptype, payload):
    conn.sendall(struct.pack("ccccIII", b"O", b"R", b"G", b"B", 0, ptype, len(payload)) + payload)


def serve(conn):
    try:
        while True:
            _o, _r, _g, _b, _dev, ptype, size = struct.unpack("ccccIII", recv_exact(conn, 16))
            if size:
                recv_exact(conn, size)
            if ptype == 40:                 # protocol version: 1 (no profiles, no plugins)
                reply(conn, 40, struct.pack("I", 1))
            elif ptype == 0:                # controller count: none
                reply(conn, 0, struct.pack("I", 0))
    except (ConnectionError, OSError, struct.error):
        pass
    finally:
        conn.close()


srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(("127.0.0.1", port))
srv.listen(8)
while True:
    c, _ = srv.accept()
    threading.Thread(target=serve, args=(c,), daemon=True).start()
