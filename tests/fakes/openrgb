#!/usr/bin/env python3
"""A stand-in for OpenRGB in tests: put this folder first on PATH.

FAKE_OPENRGB_MODE (default "zero"):
  zero    with --server: an SDK server that answers the handshake and reports no devices
  devices like zero, but with two devices: a 2 channel ARGB controller (20 LEDs each) with
          Direct, Static, Breathing, Spectrum Cycle and Wave modes, and a RAM stick (8 LEDs)
  alive   stays running without listening (an OpenRGB window with its SDK server off)
  crash   exits right away with code 3
FAKE_OPENRGB_LOG: a file each start is appended to ("PID ARG ARG...").
FAKE_OPENRGB_PACKETS: a file each colour or mode packet is appended to ("TYPE DEVICE SIZE").
"""
import copy
import os
import signal
import socket
import struct
import sys
import threading
import time

# Look like the real binary to process scans (/proc/PID/comm), not like "python3".
try:
    with open("/proc/self/comm", "w") as f:
        f.write("openrgb")
except OSError:
    pass
mode = os.environ.get("FAKE_OPENRGB_MODE", "zero")
log = os.environ.get("FAKE_OPENRGB_LOG")
if log:
    with open(log, "a") as f:
        f.write(f"{os.getpid()} {' '.join(sys.argv[1:])}\n")
print(f"fake openrgb {os.getpid()} mode={mode} args={sys.argv[1:]}", flush=True)
signal.signal(signal.SIGTERM, lambda *a: os._exit(0))
if mode == "crash":
    sys.exit(3)
if mode == "alive" or "--server" not in sys.argv:
    while True:
        time.sleep(1)

port = 6742
if "--server-port" in sys.argv:
    port = int(sys.argv[sys.argv.index("--server-port") + 1])


def recv_exact(conn, n):
    data = b""
    while len(data) < n:
        chunk = conn.recv(n - len(data))
        if not chunk:
            raise ConnectionError
        data += chunk
    return data


def reply(conn, ptype, payload):
    conn.sendall(struct.pack("ccccIII", b"O", b"R", b"G", b"B", 0, ptype, len(payload)) + payload)


DEVICES = []
VERSION = 1
if mode == "devices":
    from openrgb import utils as U

    def _mode(i, name, flags=0, color_mode=U.ModeColors.NONE, speed=None, colors=None, ncol=0):
        # settings a mode doesn't have must be None, as OpenRGB's own data has them
        sp = speed or (None, None, None)
        br = (0, 100, 100) if flags & 16 else (None, None, None)
        co = colors or (None, None)
        return U.ModeData(i, name, i, U.ModeFlags(flags), sp[0], sp[1], br[0], br[1], co[0], co[1], sp[2], br[2],
                          0, color_mode, [U.RGBColor(255, 0, 0)] * ncol if colors else None)

    def _device(name, zones, modes, dtype):
        leds, zl, cols, start = [], [], [], 0
        for zn, n in zones:
            zl.append(U.ZoneData(zn, U.ZoneType.LINEAR, 0, 200, n, 0, 0, None, [], [], [], start))
            leds += [U.LEDData(f"{zn} LED {i}", i) for i in range(n)]
            cols += [U.RGBColor(0, 0, 0)] * n
            start += n
        return U.ControllerData(name, U.MetaData("Fake", "a fake device", "1.0", "0", "fake"), dtype, leds, zl,
                                modes, cols, 1)

    SPEED, DIR_LR, BRIGHT, MODE_COLOR, PER_LED = 1, 2, 16, 64, 32
    DEVICES = [
        _device("Fake ARGB Controller", [("Channel 1", 20), ("Channel 2", 20)], [
            _mode(0, "Direct", PER_LED, U.ModeColors.PER_LED),
            _mode(1, "Static", MODE_COLOR | BRIGHT, U.ModeColors.MODE_SPECIFIC, colors=(1, 1), ncol=1),
            _mode(2, "Breathing", SPEED | MODE_COLOR | BRIGHT, U.ModeColors.MODE_SPECIFIC, (1, 5, 3), (1, 2), 2),
            _mode(3, "Spectrum Cycle", SPEED | BRIGHT, U.ModeColors.NONE, (4, 0, 2)),
            _mode(4, "Wave", SPEED | DIR_LR | BRIGHT, U.ModeColors.NONE, (1, 10, 5)),
        ], U.DeviceType.LEDSTRIP),
        _device("Fake RAM", [("Stick", 8)], [
            _mode(0, "Direct", PER_LED, U.ModeColors.PER_LED),
            _mode(1, "Rainbow", SPEED, U.ModeColors.NONE, (1, 3, 2)),
        ], U.DeviceType.DRAM),
    ]
    VERSION = 3
PACKETS = os.environ.get("FAKE_OPENRGB_PACKETS")


def note(ptype, dev, size):
    if PACKETS:
        with open(PACKETS, "a") as f:
            f.write(f"{ptype} {dev} {size}\n")


def serve(conn):
    try:
        while True:
            _o, _r, _g, _b, dev, ptype, size = struct.unpack("ccccIII", recv_exact(conn, 16))
            data = recv_exact(conn, size) if size else b""
            if ptype == 40:                 # protocol version (1: no profiles; 3 with devices)
                reply(conn, 40, struct.pack("I", VERSION))
            elif ptype == 0:                # controller count
                reply(conn, 0, struct.pack("I", len(DEVICES)))
            elif ptype == 1 and dev < len(DEVICES):
                # answer in the protocol version the client asks for, like OpenRGB does
                asked = min(struct.unpack("I", data[:4])[0] if len(data) >= 4 else VERSION, VERSION)
                d = copy.deepcopy(DEVICES[dev])
                if asked < 3:                       # brightness came with protocol 3
                    for m in d.modes:
                        m.brightness = m.brightness_min = m.brightness_max = None
                body = d.pack(asked)
                conn.sendall(struct.pack("ccccIII", b"O", b"R", b"G", b"B", dev, 1, len(body)) + body)
            elif ptype == 150:              # profile list: none
                reply(conn, 150, struct.pack("IH", 6, 0))
            elif ptype in (1000, 1050, 1051, 1052, 1100, 1101):
                if ptype in (1100, 1101) and dev < len(DEVICES) and len(data) >= 8:
                    DEVICES[dev].active_mode = struct.unpack("i", data[4:8])[0]
                note(ptype, dev, size)
    except (ConnectionError, OSError, struct.error):
        pass
    finally:
        conn.close()


srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(("127.0.0.1", port))
srv.listen(8)
while True:
    c, _ = srv.accept()
    threading.Thread(target=serve, args=(c,), daemon=True).start()
